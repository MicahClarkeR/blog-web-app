@using WebApp.Helpers;
@model ArticleListModel
@{
    ViewData["Title"] = $"Articles – {Model.Page} – Micah's Blog";
    var articleListModel = new WebApp.Models.Partial.PartialArticleListModel()
    {
        Articles = Model.Articles,
        BackLink = "/article?page=" + Model.Page + "&count=" + Model.Count
    };
}
<div style="padding-top: 10em"></div>
@{
    await Html.RenderPartialAsync("_ArticleList", articleListModel);
}