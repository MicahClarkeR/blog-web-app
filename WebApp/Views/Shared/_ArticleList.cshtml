@using WebApp.Helpers;
@model WebApp.Models.Partial.PartialArticleListModel;

<div class="article-list">
    @foreach (var article in Model.Articles)
    {
        <article>
            <header>
                @if (article.header != null)
                {
                    <img class="head-image" src="@Assets.GetImage((Guid) article.header, 960)" />
                }

                <h1 class="cardo"><a asp-controller="article" asp-action="read" asp-route-id="@article.id" asp-route-slug="@article.SlugValue" asp-route-backLink="@Model.BackLink">@article.title</a></h1>
            </header>
            <hr>
            <content>
                <section class="metadata">
                    <span id="author"><em>By: @article.GetAuthor().first_name</em></span>
                </section>

                <p class="justify">@Html.Raw(article.GetSummary())</p>
                <a class="read cardo" asp-controller="article" asp-action="read" asp-route-backLink="@Model.BackLink" asp-route-id="@article.id" asp-route-slug="@article.SlugValue"><em>Read . . .</em></a>
            </content>
        </article>
    }
</div>