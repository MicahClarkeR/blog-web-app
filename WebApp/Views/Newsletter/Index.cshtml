@using WebApp.Helpers;
@model NewsletterViewModel;

@{
    ViewData["Title"] = $"Subscribe – Micah's Blog";
}


@section Scripts
{
    <script type="text/javascript" src="~/js/article.js" asp-append-version="true"></script>
}

<form asp-controller="Newsletter" asp-action="Index">
    <h2 class="cardo">Digests</h2>
    <p>
        Receive digests to know when new posts are published, currently I am planning to post maximum once or twice a week. Thank you! It means a lot to me that you are interested in reading more.
    </p>
    <div class="flex-row">
        <label for="email">Email:</label>
        <input id="email" name="email" type="text" />
    </div>
    <div class="flex-row">
        <label for="frequency">Maximum Frequency:</label>
        <div class="flex-column">
            <div class="flex-row">
                <input type="radio" id="immediate" name="frequency" value="immediate" />
                <label for="immediate">Daily</label>
            </div>
            <div class="flex-row">
                <input type="radio" id="weekly" name="frequency" value="weekly" checked />
                <label for="weekly">Weekly</label>
            </div>
            <div class="flex-row">
                <input type="radio" id="fortnightly" name="frequency" value="fortnightly" />
                <label for="fortnightly">Fortnightly</label>
            </div>
            <div class="flex-row">
                <input type="radio" id="monthly" name="frequency" value="monthly" />
                <label for="monthly">Monthly</label>
            </div>
        </div>
    </div>

    <input type="submit" value="Submit"/>

</form>